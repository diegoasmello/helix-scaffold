{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier . --write",
    "type-check": "tsc --noEmit",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:reset": "tsx --env-file=.env src/db/reset.ts",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
    "spec:export": "tsx src/scripts/export-spec.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.9",
    "@fastify/cors": "11.2.0",
    "@fastify/multipart": "10.0.0",
    "@fastify/static": "9.1.3",
    "@fastify/swagger": "9.7.0",
    "@react-pdf/renderer": "4.5.1",
    "@scalar/fastify-api-reference": "1.52.6",
    "better-auth": "catalog:",
    "drizzle-orm": "0.45.2",
    "drizzle-seed": "0.3.1",
    "fastify": "5.8.5",
    "fastify-type-provider-zod": "6.1.0",
    "pg": "8.20.0",
    "pino-pretty": "13.1.3",
    "react": "19.2.0",
    "sharp": "0.34.5",
    "uuidv7": "1.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@faker-js/faker": "10.4.0",
    "@types/node": "catalog:",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.7",
    "@types/sharp": "0.32.0",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "prettier": "catalog:",
    "tsx": "4.21.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "catalog:"
  }
}
