# ─────────────────────────────────────────────
# Runtime environment
# ─────────────────────────────────────────────

# Controls logging level and a few dev-only behaviours (e.g. console email in test).
# Values: development | production | test
NODE_ENV=development

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────

# PostgreSQL connection string.
# Required. Example: postgresql://user:pass@localhost:5434/helix
DATABASE_URL=

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────

# Secret used by better-auth to sign session tokens.
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of this API server (used by better-auth for redirects and CORS).
# Required.
BASE_URL=http://localhost:3333

# Public URL of the frontend app (used for CORS trusted origins).
# Required.
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Registration mode
# ─────────────────────────────────────────────

# Controls who can create accounts.
#   closed (default) — only admins create accounts via POST /users.
#   open             — anyone can self-register via /sign-up; bootstrap also
#                      creates a default "User" role for new self-registered users.
REGISTRATION_MODE=closed

# ─────────────────────────────────────────────
# Subscriptions
# ─────────────────────────────────────────────

# Controls whether the subscription feature is active.
#   disabled (default) — no subscription routes registered; requireSubscription() is a no-op.
#   enabled            — full subscription infrastructure active.
SUBSCRIPTION_MODE=disabled

# Optional. When set, a trialing subscription is automatically created on user registration
# (only when REGISTRATION_MODE=open and SUBSCRIPTION_MODE=enabled).
# SUBSCRIPTION_TRIAL_DAYS=14

# ─────────────────────────────────────────────
# File uploads
# ─────────────────────────────────────────────

# Storage backend. Only 'local' is fully implemented; 's3' stub exists but throws.
# Values: local | s3
STORAGE_PROVIDER=local

# Directory where uploaded files are stored (local provider only).
UPLOAD_DIR=./storage

# Maximum upload size in megabytes.
UPLOAD_MAX_SIZE_MB=50

# Base URL prepended to storage keys to build public download URLs.
# Should match BASE_URL for local development.
UPLOAD_BASE_URL=http://localhost:3333

# ─────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────

# Resend API key for transactional email.
# Optional — omit in development/test to fall back to console logging.
RESEND_API_KEY=

# Sender address for all outgoing emails.
# Must come from a domain verified in Resend when using the Resend provider.
EMAIL_FROM=noreply@localhost

# ─────────────────────────────────────────────
# Social providers (open registration only)
# Each provider is enabled only when both CLIENT_ID and CLIENT_SECRET are set.
# Social login buttons are shown in the UI only when REGISTRATION_MODE=open.
# ─────────────────────────────────────────────

# Google — create credentials at https://console.cloud.google.com
# Authorized redirect URI: {BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — create app at https://developers.facebook.com
# Authorized redirect URI: {BASE_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Apple — requires Apple Developer account
# APPLE_CLIENT_ID: your Services ID (e.g. com.example.app.service) — NOT the App ID
# APPLE_CLIENT_SECRET: a JWT signed with your .p8 private key (max 6-month expiry).
#   Generate it following: https://developer.apple.com/documentation/sign_in_with_apple/generate_and_validate_tokens
# Authorized redirect URI: {BASE_URL}/api/auth/callback/apple
# APPLE_APP_BUNDLE_ID: optional, only needed for native iOS apps
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=
