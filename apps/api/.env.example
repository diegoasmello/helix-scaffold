# ─────────────────────────────────────────────
# Runtime environment
# ─────────────────────────────────────────────

# Controls logging level and a few dev-only behaviours (e.g. console email in test).
# Values: development | production | test
NODE_ENV=development

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────

# PostgreSQL connection string.
# Required. Example: postgresql://user:pass@localhost:5434/helix
DATABASE_URL=

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────

# Secret used by better-auth to sign session tokens.
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of this API server (used by better-auth for redirects and CORS).
# Required.
BASE_URL=http://localhost:3333

# Public URL of the frontend app (used for CORS trusted origins).
# Required.
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Registration mode
# ─────────────────────────────────────────────

# Controls who can create accounts.
#   closed (default) — only admins create accounts via POST /users.
#   open             — anyone can self-register via /sign-up; bootstrap also
#                      creates a default "User" role for new self-registered users.
REGISTRATION_MODE=closed

# ─────────────────────────────────────────────
# File uploads
# ─────────────────────────────────────────────

# Storage backend. Only 'local' is fully implemented; 's3' stub exists but throws.
# Values: local | s3
STORAGE_PROVIDER=local

# Directory where uploaded files are stored (local provider only).
UPLOAD_DIR=./storage

# Maximum upload size in megabytes.
UPLOAD_MAX_SIZE_MB=50

# Base URL prepended to storage keys to build public download URLs.
# Should match BASE_URL for local development.
UPLOAD_BASE_URL=http://localhost:3333

# ─────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────

# Resend API key for transactional email.
# Optional — omit in development/test to fall back to console logging.
RESEND_API_KEY=

# Sender address for all outgoing emails.
# Must come from a domain verified in Resend when using the Resend provider.
EMAIL_FROM=noreply@localhost
