# ─────────────────────────────────────────────
# This file holds secrets and per-deploy values only.
# Application settings (registration mode, subscriptions, uploads, email
# sender, social providers on/off, ...) live in src/app.config.ts.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# Runtime environment
# ─────────────────────────────────────────────

# Controls logging level and a few dev-only behaviours (e.g. console email in test).
# Values: development | production | test
NODE_ENV=development

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────

# PostgreSQL connection string.
# Required. Example: postgresql://user:pass@localhost:5434/helix
DATABASE_URL=

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────

# Secret used by better-auth to sign session tokens.
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of this API server (used by better-auth for redirects, and
# prepended to storage keys to build public upload URLs).
# Required.
BASE_URL=http://localhost:3333

# Public URL of the frontend app (used for CORS trusted origins).
# Required.
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────

# Resend API key for transactional email.
# Optional — omit in development/test to fall back to console logging.
# The sender address is set in src/app.config.ts → email.from.
RESEND_API_KEY=

# ─────────────────────────────────────────────
# Payment processor (optional)
# Secrets for the adapter registered in src/config/billing-webhook.ts.
# Add the variables your adapter needs to src/env.ts, e.g. for the
# reference HMAC adapter:
# BILLING_WEBHOOK_SECRET=
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# Social providers
# Turn a provider on in src/app.config.ts → auth.socialProviders.<name>.enabled,
# then set its credentials here. The API refuses to start if an enabled
# provider is missing them.
# ─────────────────────────────────────────────

# Google — create credentials at https://console.cloud.google.com
# Authorized redirect URI: {BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — create app at https://developers.facebook.com
# Authorized redirect URI: {BASE_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Apple — requires Apple Developer account
# APPLE_CLIENT_ID: your Services ID (e.g. com.example.app.service) — NOT the App ID
# APPLE_CLIENT_SECRET: a JWT signed with your .p8 private key (max 6-month expiry).
#   Generate it following: https://developer.apple.com/documentation/sign_in_with_apple/generate_and_validate_tokens
# Authorized redirect URI: {BASE_URL}/api/auth/callback/apple
# The native iOS bundle ID (optional) goes in src/app.config.ts → auth.socialProviders.apple.appBundleId
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
