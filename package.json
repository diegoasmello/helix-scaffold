{
  "name": "helix",
  "version": "1.0.0",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter api run db:generate",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:seed": "pnpm --filter api run db:seed",
    "db:reset": "pnpm --filter api run db:reset",
    "db:migrate:test": "pnpm --filter api run db:migrate:test",
    "spec:export": "pnpm --filter @helix/api-client export-spec",
    "spec:generate": "pnpm --filter @helix/api-client generate",
    "spec:sync": "pnpm --filter @helix/api-client sync"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "better-auth"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.2",
    "@commitlint/config-conventional": "20.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "turbo": "2.11.10"
  }
}
