# The build context of the Dockerfile: the sources, never what a machine
# generated or holds locally.
.git
.agents
.claude
.turbo
**/node_modules
**/dist
**/coverage

# Secrets: the images never carry one (the API gets them at run time).
**/.env
**/.env.*

# Generated by the install (postinstall) from openapi.json
packages/api-client/src/generated

# Local data and test output
apps/api/storage
apps/web/playwright-report
apps/web/test-results
apps/web/blob-report
apps/web/e2e/.auth
