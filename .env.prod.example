# ─────────────────────────────────────────────
# Production values for docker-compose.prod.yml. Copy to .env.prod on the
# server (never committed), readable by its owner only (chmod 600 .env.prod:
# it holds the database password and AUTH_SECRET), and fill in — README →
# Deploying with Docker.
# Product settings stay in apps/api/src/app.config.ts.
# ─────────────────────────────────────────────

# The product's slug: the compose project (`<slug>-prod`), the database and
# its user. Never change it after the first deploy: it names the volumes, so
# the stack would start on new, empty ones — and /bootstrap would take a new
# admin from anyone.
APP_SLUG=

# The public host name, without the scheme: the web at https://DOMAIN, the
# API at https://DOMAIN/api. Its DNS points to this server.
# Without a domain: the server's IP with dashes and .sslip.io
# (203-0-113-10.sslip.io), which also gets a real certificate.
DOMAIN=

# Generate with: openssl rand -hex 32 (hex: it goes into the database URL as
# it is). PostgreSQL applies it only when it creates its volume: changing it
# here later locks the API out. To change it, first in the database —
#   docker compose -f docker-compose.prod.yml --env-file .env.prod exec db \
#     sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "\password"'
# — then here, then `up -d`.
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 32 — never the development one.
# Changing it signs everyone out.
AUTH_SECRET=

# Required with email.enabled: true in app.config.ts; unused otherwise.
RESEND_API_KEY=

# Each social provider enabled in app.config.ts, and any secret a payment
# adapter adds to src/env.ts: the names of apps/api/.env.example.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
