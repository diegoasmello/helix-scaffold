{
  "name": "@helix/api-client",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "scripts": {
    "dev": "kubb generate --watch",
    "lint": "eslint .",
    "format": "prettier . --write",
    "type-check": "tsc --noEmit",
    "export-spec": "pnpm --filter api spec:export ../../packages/api-client/openapi.json",
    "generate": "KUBB_DISABLE_TELEMETRY=1 KUBB_INPUT=./openapi.json kubb generate",
    "postinstall": "KUBB_DISABLE_TELEMETRY=1 KUBB_INPUT=./openapi.json kubb generate"
  },
  "exports": {
    ".": "./index.ts",
    "./types": "./src/generated/types/index.ts",
    "./hooks": "./src/generated/hooks/index.ts",
    "./mocks": "./src/generated/mocks/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@faker-js/faker": "10.4.0",
    "@kubb/cli": "4.37.8",
    "@kubb/core": "4.37.8",
    "@kubb/plugin-faker": "4.37.8",
    "@kubb/plugin-msw": "4.37.8",
    "@kubb/plugin-oas": "4.37.8",
    "@kubb/plugin-react-query": "4.37.8",
    "@kubb/plugin-ts": "4.37.8",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "16.5.0",
    "msw": "2.13.6",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.100.1"
  },
  "lint-staged": {
    "**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
