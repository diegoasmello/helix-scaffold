{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^type-check"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "format": {},
    "test": {
      "dependsOn": ["^type-check"]
    },
    "test:coverage": {
      "dependsOn": ["^type-check"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false
    },
    "test:watch": {
      "persistent": true,
      "cache": false
    }
  }
}
